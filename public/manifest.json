{
  "manifest_version": 3,
  "name": "ChatGraph",
  "version": "0.1.0",
  "description": "查看 ChatGPT 对话的消息树、历史版本和派生分支，点击节点定位对话历史。",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "scripting", "storage", "webNavigation"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 ChatGraph" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
